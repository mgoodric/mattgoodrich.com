flowchart TB
  O["<b>Observation</b><br/>Default-grant in data classification boundary"]
  G1{"Gate: observation period elapsed,<br/>incidents avoided, false positives caught"}
  D["<b>Drafting</b><br/>Output reviewed; acceptance rate tracked"]
  G2{"Gate: reviewer catch rate above threshold"}
  M["<b>Modification</b><br/>Per-write approval gate"]
  G3{"Gate: incident rate at or below baseline"}
  S["<b>Sanction</b><br/>Maker-checker wired and measured"]
  G4{"Gate: checker false-positive rate within tolerance"}
  E["<b>Execution</b><br/>Kill switch tested in non-prod drill"]
  G5{"Gate: kill switch drill passed"}
  X["<b>Destruction</b><br/>May never unlock<br/>Correct answer for many agents"]
  Demo["Demotion is automatic on threshold breach,<br/>and applies at every gate"]

  O --> G1 --> D --> G2 --> M --> G3 --> S --> G4 --> E --> G5 --> X
  G3 -.- Demo
