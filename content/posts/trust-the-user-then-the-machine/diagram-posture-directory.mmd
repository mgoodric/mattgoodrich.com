flowchart TD
  AGENT["MDM + EDR agent on the device<br/>runs on its own schedule"]
  AGENT -->|"reads live posture:<br/>encryption, OS patch, EDR alive"| MDMSVC["MDM service"]
  MDMSVC -->|"writes the verdict"| DIR[("Directory device object<br/>compliant: true / false")]
  BROWSER(["At login: browser presents<br/>device cert or bound key"]) -->|"identity, verified live"| IDP{{"IdP / conditional access"}}
  DIR -. "IdP looks up the stored verdict<br/>(only as fresh as the last check-in)" .-> IDP
  IDP --> DEC{"Compliant flag set?"}
  DEC -->|yes| OK["Allow"]
  DEC -->|no| NO["Block or step up"]
