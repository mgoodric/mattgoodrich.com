flowchart TD
  BROWSER(["At login: browser presents<br/>device cert or bound key"]) -->|"identity, verified live"| IDP{{"IdP"}}
  IDP -->|"needs posture,<br/>can't read the OS itself"| HANDOFF{{"Hand off to the local agent<br/>native messaging / 127.0.0.1 / URL scheme"}}
  HANDOFF --> AGENT["Native agent on the device"]
  AGENT -->|"reads posture now,<br/>signs it with the device key"| SIGNED["Signed posture result"]
  SIGNED -. "returned as part of the login" .-> IDP
  IDP --> DEC{"Healthy and<br/>signature valid?"}
  DEC -->|yes| OK["Allow"]
  DEC -->|no| NO["Block or step up"]
