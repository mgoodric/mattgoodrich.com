flowchart TB
  subgraph A1["Architecture 1: Pre-issued bearer token"]
    direction LR
    A1_AGENT["Agent"] -->|"bearer token<br/>(from secret store / .env)"| A1_MCP["MCP server"]
  end
  subgraph A2["Architecture 2: OAuth 2.1 Client Credentials"]
    direction LR
    A2_AGENT["Agent<br/>(its own OAuth client)"] -->|"grant_type=<br/>client_credentials"| A2_IDP["IdP /token<br/>endpoint"]
    A2_IDP -->|"short-lived access token<br/>(agent identity only)"| A2_MCP["MCP server"]
  end
  subgraph A3["Architecture 3: OAuth Token Exchange (RFC 8693) on workload identity"]
    direction LR
    A3_AGENT["Agent with<br/>SPIFFE SVID"] -->|"subject_token = SVID"| A3_BROKER["Token broker /<br/>Authorization Server"]
    A3_BROKER -->|"MCP-scoped token<br/>(sub = agent, act.sub = user)"| A3_MCP["MCP server"]
  end
  subgraph A4["Architecture 4: Skip MCP. Call the API directly with workload identity"]
    direction LR
    A4_AGENT["Agent"] -->|"AssumeRoleWithWebIdentity"| A4_STS["AWS STS<br/>(or GCP/Azure equiv)"]
    A4_STS -->|"short-lived STS credentials"| A4_API["API directly<br/>(no MCP in path)"]
  end
  A1 ~~~ A2
  A2 ~~~ A3
  A3 ~~~ A4
